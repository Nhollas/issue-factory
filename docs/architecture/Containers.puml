@startuml
set separator none
title Issue factory: parts and external systems

top to bottom direction

!include <C4/C4>
!include <C4/C4_Context>
!include <C4/C4_Container>

AddElementTag("Container,Queue", $bgColor="#4a6fa5", $borderColor="#2b2b2b", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid", $borderThickness="2")
AddElementTag("Person,Human", $bgColor="#4aa563", $borderColor="#2b2b2b", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid", $borderThickness="2")
AddElementTag("Container,Database", $bgColor="#4a6fa5", $borderColor="#2b2b2b", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid", $borderThickness="2")
AddElementTag("Container", $bgColor="#4a6fa5", $borderColor="#2b2b2b", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid", $borderThickness="2")
AddElementTag("Software System,External", $bgColor="#7f7f7f", $borderColor="#2b2b2b", $fontColor="#ffffff", $sprite="", $shadowing="", $borderStyle="solid", $borderThickness="2")

AddRelTag("Relationship", $textColor="#2b2b2b", $lineColor="#2b2b2b", $lineStyle = "")
AddRelTag("Webhook", $textColor="#2b2b2b", $lineColor="#2b2b2b", $lineStyle = DashedLine())

AddBoundaryTag("Software System", $bgColor="#ffffff", $borderColor="#2b2b2b", $fontColor="#2b2b2b", $shadowing="", $borderStyle="solid", $borderThickness="2")

Person(Factoryengineer, "Factory engineer", $descr="Changes the factory definition and compares versions.", $tags="Person,Human", $link="")
System(GitHub, "GitHub", $descr="Issues, repositories, pull requests and their checks.", $tags="Software System,External", $link="")
System(AWSBedrockAgentCoreRuntime, "AWS Bedrock AgentCore Runtime", $descr="Hosts each run's agent session in an isolated microVM. One runtime version per factory version.", $tags="Software System,External", $link="")
System(Modelvendors, "Model vendors", $descr="Anthropic in the first version; OpenAI later.", $tags="Software System,External", $link="")

System_Boundary("Issuefactory_boundary", "Issue factory", $tags="Software System") {
  ContainerQueue(Issuefactory.Deadletterqueue, "Dead-letter queue", $techn="AWS SQS", $descr="Holds events the handler repeatedly fails to process.", $tags="Container,Queue", $link="")
  Container(Issuefactory.Eventhandler, "Event handler", $techn="AWS Lambda Event Function", $descr="Starts a run when the label is added and no run is active. Records the result when a run's pull request is merged or closed.", $tags="Container", $link="")
  Container(Issuefactory.Run, "Run", $techn="AWS Lambda durable function, one execution per run", $descr="Starts the agent session for the chosen version, opens the pull request and posts progress. Ends when the pull request opens or the run fails.", $tags="Container", $link="")
  Container(Issuefactory.Agentsandbox, "Agent sandbox", $techn="Claude Agent SDK in one container image per factory version", $descr="The run's agent: a harness and the definition's files, working on a checkout of the repository.", $tags="Container", $link="")
  ContainerDb(Issuefactory.Runrecord, "Run record", $techn="AWS DynamoDB", $descr="What ran, on what, the session's time and cost, and the outcome. Knows whether an issue has an active run.", $tags="Container,Database", $link="")
  Container(Issuefactory.Factorydefinition, "Factory definition", $techn="GitHub repository", $descr="Instructions, skills, hooks, harness and model. Each semver tag builds the sandbox image for that version.", $tags="Container", $link="")
  Container(Issuefactory.Webhookreceiver, "Webhook receiver", $techn="AWS Lambda Event Function with a function URL", $descr="Verifies GitHub webhooks and queues the events.", $tags="Container", $link="")
  ContainerQueue(Issuefactory.Eventqueue, "Event queue", $techn="AWS SQS", $descr="Holds events until the handler processes them.", $tags="Container,Queue", $link="")
}

Rel(Factoryengineer, Issuefactory.Factorydefinition, "Changes and tags the definition", $techn="Git", $tags="Relationship", $link="")
Rel(Factoryengineer, Issuefactory.Runrecord, "Compares versions", $techn="", $tags="Relationship", $link="")
Rel(GitHub, Issuefactory.Webhookreceiver, "Sends issue and pull request events", $techn="GitHub App webhook", $tags="Webhook", $link="")
Rel(Issuefactory.Webhookreceiver, Issuefactory.Eventqueue, "Queues verified events", $techn="SQS", $tags="Relationship", $link="")
Rel(Issuefactory.Eventqueue, Issuefactory.Deadletterqueue, "Moves events received too many times", $techn="SQS redrive", $tags="Relationship", $link="")
Rel(Issuefactory.Eventhandler, Issuefactory.Eventqueue, "Receives events", $techn="Event source mapping", $tags="Relationship", $link="")
Rel(Issuefactory.Eventhandler, Issuefactory.Runrecord, "Checks for an active run; adds the pull request's result", $techn="", $tags="Relationship", $link="")
Rel(Issuefactory.Eventhandler, GitHub, "Reads check results", $techn="REST", $tags="Relationship", $link="")
Rel(Issuefactory.Eventhandler, Issuefactory.Run, "Starts a run", $techn="Lambda invoke", $tags="Relationship", $link="")
Rel(Issuefactory.Run, Issuefactory.Factorydefinition, "Resolves the chosen version, or the newest tag", $techn="Git", $tags="Relationship", $link="")
Rel(Issuefactory.Run, GitHub, "Mints the run's token, opens the pull request, posts progress on the issue", $techn="REST", $tags="Relationship", $link="")
Rel(Issuefactory.Run, AWSBedrockAgentCoreRuntime, "Starts the session at the version's endpoint; reads back its events, result and cost", $techn="AgentCore API", $tags="Relationship", $link="")
Rel(Issuefactory.Run, Issuefactory.Runrecord, "Writes versions, inputs, time and cost, outcome", $techn="", $tags="Relationship", $link="")
Rel(AWSBedrockAgentCoreRuntime, Issuefactory.Agentsandbox, "Runs the session", $techn="", $tags="Relationship", $link="")
Rel(Issuefactory.Agentsandbox, GitHub, "Clones the repository and pushes the run branch", $techn="Git", $tags="Relationship", $link="")
Rel(Issuefactory.Agentsandbox, Modelvendors, "Runs the agent loop", $techn="Model inference", $tags="Relationship", $link="")

SHOW_LEGEND(true)
@enduml